    {
      "site_id": "ASIC1-internal-147-lit",
      "gene_symbol": "ASIC1",
      "uniprot_acc": "P78348",
      "provenance": "literature_retrieved",
      "det_path": null,
      "site_kind": "internal",
      "insert_after_residue": 147,
      "residue_before": "F",
      "residue_after": "K",
      "residue_label": "F147",
      "topology_state": "O",
      "extracellular": true,
      "compartment": "extracellular",
      "tag_type": "short epitope, ALFA 15 aa, GS linkers",
      "tag_length_aa": null,
      "linker": null,
      "evidence_type": "published tag insertion at this exact site",
      "functional_impact_measured": "Surface expression confirmed by non-permeabilized anti-HA immunostaining in transfected cells (PMC7870742); surface-expression profiling by FLAG insertion at the same junction (PMC8654947). Acid-evoked channel function (electrophysiology) was NOT MEASURED for the tagged constructs in the cited sources.",
      "confidence": "high",
      "rationale": "The ledger (PMC7870742) explicitly names the junction Phe147\u2013Lys148 in full-length membrane-anchored human and rat ASIC1a. Python verification confirms residue 147 = F and residue 148 = K in the canonical 528-aa sequence. Both residues fall deep in the extracellular domain (positions 63\u2013437), 85 residues from the cytoplasmic end of TM1 and 290 residues from TM2, satisfying the \u22653-residue TM-clearance rule by a wide margin. The site is an internal loop insertion. A second independent ledger line (PMC8654947) cites a FLAG insertion at the identical F147|K148 junction in a surface-expression screen, elevating confidence. The ALFA tag (~15 aa) with GS linkers is comparable in size to the HA inserts (9 aa) and 2\u00d7HA (18 aa) already tolerated here. PMC source \u2192 supporting_pmid set to null; PMC7870742 cited in rationale. [validation: surface_only; position: validated; source: paper; entailment_verified: True]",
      "sources": [
        {
          "citation": "preprint",
          "claim": "To selectively label the channels exposed on the cell surface, an HA epitope was genetically inserted into the extracellular loop of rat ASIC1a (rASIC1a) or hASIC1a between residues Phe 147 and Lys 148 (ASIC1a- 147 HA 148 , see Fig. 1 A, upper panel)."
        }
      ],
      "plddt": null,
      "conservation_rank": null,
      "median_conservation": null
    },
    {
      "site_id": "ASIC1-internal-298-lit",
      "gene_symbol": "ASIC1",
      "uniprot_acc": "P78348",
      "provenance": "literature_retrieved",
      "det_path": null,
      "site_kind": "internal",
      "insert_after_residue": 298,
      "residue_before": "D",
      "residue_after": "L",
      "residue_label": "D298",
      "topology_state": "O",
      "extracellular": true,
      "compartment": "extracellular",
      "tag_type": "short epitope, ALFA 15 aa, GS linkers",
      "tag_length_aa": null,
      "linker": null,
      "evidence_type": "published tag insertion at this exact site",
      "functional_impact_measured": "Surface expression confirmed by non-permeabilized anti-HA immunostaining and by pHluorin fluorescence at the cell surface under non-permeabilized conditions (PMC7870742). Acid-evoked channel function (electrophysiology) was NOT MEASURED for the tagged constructs in the cited source.",
      "confidence": "high",
      "rationale": "The ledger (PMC7870742) explicitly names the junction Asp298\u2013Leu299 in full-length membrane-anchored human ASIC1a. Python verification confirms residue 298 = D and residue 299 = L in the canonical 528-aa sequence. Both residues fall within the extracellular domain (positions 63\u2013437), 236 residues from TM1 and 139 residues from TM2, satisfying the \u22653-residue TM-clearance rule. The site is an internal loop insertion. Notably, the same junction tolerated replacement of the HA tag with pHluorin (~240 aa), a much larger insert than the ALFA tag (~15 aa) proposed here, strongly supporting steric plausibility. The ledger line from PMC8318589 (deletion of D298 and L299) was considered but does not qualify as an insertion-tolerance citation and was not used to ground this site. PMC source \u2192 supporting_pmid set to null; PMC7870742 cited in rationale. [validation: surface_only; position: validated; source: paper; entailment_verified: True]",
      "sources": [
        {
          "citation": "preprint",
          "claim": "For the hASIC1a-HA plasmid, the hemagglutinin (HA) epitope (YPYDVPDYA) of influenza virus was inserted in the extracellular loop of hASIC1a: one or two copies between residues Phe 147 and Lys 148 [ 57 , 58 ], or one copy between Asp 298 and Leu 299 ."
        }
      ],
      "plddt": null,
      "conservation_rank": null,
      "median_conservation": null
    },
